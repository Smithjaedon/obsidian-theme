    "notification.background": "#252525",
    "notification.foreground": "#d4d4d4",
    "notification.buttonBackground": "#363636",
    "notification.buttonHoverBackground": "#2d2d2d",
    "notification.infoBackground": "#74ade81a",
    "notification.infoForeground": "#74ade8",
    "notification.warningBackground": "#dec1841a",
    "notification.warningForeground": "#dec184",
    "notification.errorBackground": "#d072771a",
    "notification.errorForeground": "#d07277",

    "badge.background": "#363636",

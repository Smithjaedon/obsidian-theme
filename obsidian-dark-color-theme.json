    "menu.separatorBackground": "#2a2a2a",
    "menubar.selectionBackground": "#2d2d2d",
    "menubar.selectionForeground": "#d4d4d4",

    "settings.dropdownBackground": "#252525",
    "settings.dropdownForeground": "#d4d4d4",
    "settings.dropdownBorder": "#181818",
    "settings.headerForeground": "#d4d4d4",
    "settings.modifiedItemIndicator": "#74ade8",
    "settings.numberInputBackground": "#252525",
    "settings.numberInputForeground": "#d4d4d4",
    "settings.textInputBackground": "#252525",
    "settings.textInputForeground": "#d4d4d4",
    "settings.checkboxBackground": "#252525",
    "settings.checkboxForeground": "#d4d4d4",

    "minimap.background": "#181818",

    "diffEditor.insertedTextBackground": "#98c37933",

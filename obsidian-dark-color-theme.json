    "merge.incomingContentBackground": "#98c3791a",
    "merge.border": "#181818"
  },
  "tokenColors": [
    {
      "scope": ["comment", "comment.line", "comment.block"],
      "settings": { "foreground": "#5d636f", "fontStyle": "" }
    },
    {
      "scope": ["comment.block.documentation"],
      "settings": { "foreground": "#878e98", "fontStyle": "" }
    },
    {
      "scope": ["constant", "constant.other"],
      "settings": { "foreground": "#dfc184" }
    },
    {
      "scope": ["constant.language.boolean"],
      "settings": { "foreground": "#bf956a" }
    },
    {
      "scope": ["constant.numeric"],
      "settings": { "foreground": "#bf956a" }
    },
    {
      "scope": ["constant.character.escape"],
      "settings": { "foreground": "#878e98" }
    },
    {
      "scope": ["constant.other.symbol"],
      "settings": { "foreground": "#bf956a" }
    },
    {
      "scope": ["entity.name.tag"],
      "settings": { "foreground": "#74ade8" }
    },
    {
      "scope": ["entity.name.function", "support.function"],
      "settings": { "foreground": "#73ade9" }
    },
    {
      "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"],
      "settings": { "foreground": "#6eb4bf" }
    },
    {
      "scope": ["entity.name.namespace"],
      "settings": { "foreground": "#dce0e5" }
    },
    {
      "scope": ["entity.name.section"],
      "settings": { "foreground": "#d07277" }
    },
    {
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#74ade8" }
    },
    {
      "scope": ["entity.other.attribute-name.pseudo-class", "entity.other.attribute-name.pseudo-element"],
      "settings": { "foreground": "#74ade8" }
    },
    {
      "scope": ["keyword", "keyword.control"],
      "settings": { "foreground": "#b477cf" }
    },
    {
      "scope": ["keyword.operator"],
      "settings": { "foreground": "#6eb4bf" }
    },
    {
      "scope": ["keyword.control.directive", "meta.preprocessor"],
      "settings": { "foreground": "#b477cf" }
    },
    {
      "scope": ["markup.italic"],
      "settings": { "foreground": "#74ade8", "fontStyle": "italic" }
    },
    {
      "scope": ["markup.bold"],
      "settings": { "foreground": "#bf956a", "fontStyle": "bold" }
    },
    {
      "scope": ["markup.underline.link"],
      "settings": { "foreground": "#73ade9", "fontStyle": "italic" }
    },
    {
      "scope": ["constant.other.link"],
      "settings": { "foreground": "#6eb4bf" }
    },
    {
      "scope": ["markup.inserted"],
      "settings": { "foreground": "#98c379" }
    },
    {
      "scope": ["markup.deleted"],
      "settings": { "foreground": "#e06c75" }
    },
    {
      "scope": ["punctuation", "punctuation.definition", "punctuation.separator", "punctuation.delimiter"],
      "settings": { "foreground": "#acb2be" }
    },
    {
      "scope": ["punctuation.definition.bracket", "punctuation.section.bracket"],
      "settings": { "foreground": "#b2b9c6" }
    },
    {
      "scope": ["punctuation.definition.list_item"],
      "settings": { "foreground": "#d07277" }
    },
    {
      "scope": ["punctuation.definition.tag"],
      "settings": { "foreground": "#d07277" }
    },
    {
      "scope": ["punctuation.special"],
      "settings": { "foreground": "#b1574b" }
    },
    {
      "scope": ["string", "string.quoted"],
      "settings": { "foreground": "#a1c181" }
    },
    {
      "scope": ["string.regexp"],
      "settings": { "foreground": "#bf956a" }
    },
    {
      "scope": ["string.other.link", "string.unquoted"],
      "settings": { "foreground": "#bf956a" }
    },
    {
      "scope": ["string.unquoted"],
      "settings": { "foreground": "#a1c181" }
    },
    {
      "scope": ["support.type.enum"],
      "settings": { "foreground": "#6eb4bf" }
    },
    {
      "scope": ["support.constant.property-value"],
      "settings": { "foreground": "#dfc184" }
    },
    {
      "scope": ["variable", "variable.other"],
      "settings": { "foreground": "#acb2be" }
    },
    {
      "scope": ["variable.other.property", "support.variable.property"],
      "settings": { "foreground": "#d07277" }
    },
    {
      "scope": ["variable.other.readwrite", "variable.other.constant"],
      "settings": { "foreground": "#bf956a" }
    },
    {
      "scope": ["variable.language", "variable.other.special"],
      "settings": { "foreground": "#bf956a" }
    }
  ]
}
